# API production environment template.
# For local dev all of these are set in docker-compose.yml — no .env file needed.
#
# DO NOT commit a filled-in copy of this file.

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave unset in production (uses real S3 endpoint).
# Set to http://localhost:9000 when running the API outside Docker against local MinIO.
# AWS_ENDPOINT_URL=

# Leave unset in production.
# Set to the publicly reachable MinIO URL when running outside Docker.
# AWS_PRESIGN_ENDPOINT_URL=

INPUT_BUCKET=
OUTPUT_BUCKET=
QUEUE_URL=
PORT=4000
