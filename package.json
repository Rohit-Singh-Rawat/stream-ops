{
  "name": "stream-ops",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:db": "docker compose up -d postgres db-migrate && turbo run dev --filter=!@stream-ops/worker",
    "docker:db": "docker compose up -d postgres db-migrate",
    "dev:docker": "docker compose up -d",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.17",
    "turbo-windows-64": "2.8.17",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "aws-cdk": "^2.1117.0"
  }
}
