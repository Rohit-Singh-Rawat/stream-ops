# Local development environment template.
# All values here are baked into docker-compose.yml already — this file is
# provided only if you need to run services outside Docker (e.g. bun run dev).
#
# DO NOT commit a filled-in copy of this file.

# Shared
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stream_ops

# MinIO (local S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=stream-ops
AWS_SECRET_ACCESS_KEY=stream-ops-secret
AWS_ENDPOINT_URL=http://localhost:9000
INPUT_BUCKET=stream-ops-input
OUTPUT_BUCKET=stream-ops-output

# API only — when running outside Docker, ops and presign both hit localhost:9000
AWS_PRESIGN_ENDPOINT_URL=http://localhost:9000

# ElasticMQ (local SQS)
QUEUE_URL=http://localhost:9324/queue/jobs

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:9000/stream-ops-output
