# Worker production environment template.
# In production these are split between the ECS Task Definition and the
# orchestrator's containerOverrides (VIDEO_ID, S3_BUCKET, S3_KEY).
# For local dev all of these are set in docker-compose.yml — no .env file needed.
#
# DO NOT commit a filled-in copy of this file.

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Leave unset in production (uses real S3 endpoint).
# Set to http://localhost:9000 when running the worker outside Docker against local MinIO.
# AWS_ENDPOINT_URL=

OUTPUT_BUCKET=
DATABASE_URL=

# Production one-shot mode only (set by orchestrator containerOverrides in ECS):
# VIDEO_ID=
# S3_BUCKET=
# S3_KEY=

# Local poll mode only (set in docker-compose.yml):
# QUEUE_URL=
