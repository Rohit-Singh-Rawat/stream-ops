# Local development only — copy to .env and fill in values.
# In production these are split across the ECS Task Definition (.env.task-def.example)
# and the orchestrator's containerOverrides (VIDEO_ID, S3_BUCKET, S3_KEY).

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=http://localhost:4566

OUTPUT_BUCKET=your-output-bucket

DATABASE_URL=postgresql://user:password@localhost:5432/streamops

VIDEO_ID=test-video-id
S3_BUCKET=your-input-bucket
S3_KEY=uploads/test-video-id/video.mp4
