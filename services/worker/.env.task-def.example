# ECS Task Definition — Environment Variables
# Set these as static environment variables on the Task Definition,
# either via the AWS console or your IaC (Terraform / CDK / SAM).
#
# For secrets (DATABASE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY),
# prefer valueFrom referencing AWS Secrets Manager or SSM Parameter Store
# over plaintext values.

AWS_REGION=us-east-1

OUTPUT_BUCKET=your-output-bucket

DATABASE_URL=postgresql://user:password@prod-host:5432/streamops

# Only needed if NOT using an ECS task IAM role (IAM role is strongly preferred).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
