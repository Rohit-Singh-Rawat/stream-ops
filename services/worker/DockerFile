FROM oven/bun:1

RUN apt-get update && \
	apt-get install -y ffmpeg && \
	rm -rf /var/lib/apt/lists/*

WORKDIR /repo

COPY package.json bun.lock ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services

RUN bun install --production --frozen-lockfile

WORKDIR /repo/services/worker
CMD ["bun", "start"]
