# Production environment template.
# Copy to .env and fill in values for your AWS account.
# For local development use .env.local.example instead.
#
# DO NOT commit a filled-in copy of this file.

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

INPUT_BUCKET=
OUTPUT_BUCKET=

# Database (shared across api + worker)
DATABASE_URL=

# Where processed assets are publicly reachable (CloudFront recommended)
NEXT_PUBLIC_ASSET_BASE_URL=https://your-distribution.cloudfront.net
