AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET

INPUT_BUCKET=your-input-bucket
OUTPUT_BUCKET=your-output-bucket

# Full SQS QueueUrl (not name)
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/transcode

# Where the processed assets are publicly reachable (CloudFront recommended)
NEXT_PUBLIC_ASSET_BASE_URL=https://your-distribution.cloudfront.net

