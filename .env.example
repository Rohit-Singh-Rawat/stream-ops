AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

INPUT_BUCKET=your-input-bucket
OUTPUT_BUCKET=your-output-bucket

# Database (shared across api + worker)
DATABASE_URL=postgresql://user:password@localhost:5432/streamops

# Where processed assets are publicly reachable (CloudFront recommended)
NEXT_PUBLIC_ASSET_BASE_URL=https://your-distribution.cloudfront.net
